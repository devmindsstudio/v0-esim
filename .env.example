# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.

# ---- eTijwaal (SERVER-ONLY — never expose the signature) ----
# Use THESE names. Catalogue browsing and ordering both run server side, through
# /api/catalogue/* and /api/orders, so the browser never receives the signature.
ETIJWAAL_EMAIL=
ETIJWAAL_SIGNATURE=

# DEPRECATED — do not use. The NEXT_PUBLIC_ prefix makes Next.js inline the value
# into the public client bundle, which leaked the partner signature to every
# visitor. The server still reads these as a fallback so existing installs keep
# working; delete them from .env.local once ETIJWAAL_* above are set.
# NEXT_PUBLIC_ETIJWAAL_EMAIL=
# NEXT_PUBLIC_ETIJWAAL_SIGNATURE=
# Ordering mode: 'validate' (dev — confirms price, no purchase, demo QR) or
# 'transaction' (real — buys the eSIM and returns a real QR). Default: validate.
ETIJWAAL_ORDER_MODE=validate
# Dev-only test package id sent to eTijwaal (agent-provided, e.g. 31565).
# Leave BLANK in production so the distributor's real catalogue package is used.
ETIJWAAL_TEST_PACKAGE_ID=31565
# Optional override of the API base (defaults to the live partner API).
ETIJWAAL_API_URL=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser (no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email delivery (SMTP) ----
# Used to email the eSIM QR to customers, sent FROM the mailbox below.
# Leave blank to keep email delivery off (on-screen / print still works).
#   Google Workspace : smtp.gmail.com     port 465  (use an App Password)
#   Zoho             : smtp.zoho.com      port 465
#   Microsoft 365    : smtp.office365.com port 587  (SMTP_SECURE=false)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true when SMTP_PORT is 465.
SMTP_SECURE=
# Display sender shown to the customer.
MAIL_FROM=
